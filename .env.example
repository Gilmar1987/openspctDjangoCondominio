# Copie para .env e preencha. Nunca versione o .env.
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Porta do host para a aplicação (padrão 8000; troque se já estiver em uso)
WEB_PORT=8000

POSTGRES_DB=controle_condominio
POSTGRES_USER=controle_condominio
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
