# Copie para .env e preencha. Nunca versione o .env.
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Porta do host para a aplicação (padrão 8000; troque se já estiver em uso)
WEB_PORT=8000

# Proteção de dados pessoais (ADR-0009). Obrigatórias. Perder a FIELD_ENCRYPTION_KEY
# torna ilegíveis os CPFs já gravados. Gere com:
#   FIELD_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   CPF_HASH_KEY:         python -c "import secrets; print(secrets.token_hex(32))"
FIELD_ENCRYPTION_KEY=troque-por-uma-chave-fernet
CPF_HASH_KEY=troque-por-um-segredo-aleatorio

POSTGRES_DB=controle_condominio
POSTGRES_USER=controle_condominio
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
